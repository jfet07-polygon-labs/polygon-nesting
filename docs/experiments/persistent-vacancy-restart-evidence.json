  "decision": {
    "result": "state_continuation_supported_without_completion_queue_continuity_rejected",
    "supportedClaim": "Continuing the round-zero state with a rebuilt queue passes the declared strict comparator gate by reaching a distinct exact-valid endpoint with the same inactive count and 41205 fewer doubled grid-area units; the preserved queue is also proven to be an execution input rather than diagnostic-only state.",
