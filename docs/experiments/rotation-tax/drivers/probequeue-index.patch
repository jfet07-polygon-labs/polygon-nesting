+/// The eviction order of [`RotationCache::probes`], as an index rather than a
+/// scan: the variant docs/experiments/rotation-tax/ §2.3 built, measured and
+/// did **not** ship.
+///
+/// Two ordered maps and a monotone stamp reproduce the deque's order to the
+/// element - `order` is the queue read front-to-back, `stamp` is the inverse -
+/// and every operation is `O(log n)` instead of a linear scan plus a memmove.
+/// At the shipped window of [`ROTATION_CACHE_PROBE_CAPACITY`] it is 0.38%
+/// slower on the slice and 1.14% slower on the process, over 24 paired
+/// equal-work cells. It is kept as a patch rather than as code because the
+/// trade flips if the window is ever raised.
+#[cfg(feature = "continuous-rotation")]
+#[derive(Default)]
+struct ProbeQueue {
+    stamp: BTreeMap<SurrogateKey, u64>,
+    order: BTreeMap<u64, SurrogateKey>,
+    next: u64,
+}
+
+#[cfg(feature = "continuous-rotation")]
+impl ProbeQueue {
+    fn len(&self) -> usize {
+        self.order.len()
+    }
+
+    fn contains(&self, key: &SurrogateKey) -> bool {
+        self.stamp.contains_key(key)
+    }
+
+    fn push_back(&mut self, key: SurrogateKey) {
+        if let Some(previous) = self.stamp.insert(key, self.next) {
+            self.order.remove(&previous);
+        }
+        self.order.insert(self.next, key);
+        self.next = self.next.wrapping_add(1);
+    }
+
+    fn remove(&mut self, key: &SurrogateKey) {
+        if let Some(previous) = self.stamp.remove(key) {
+            self.order.remove(&previous);
+        }
+    }
+
+    fn pop_front(&mut self) -> Option<SurrogateKey> {
+        let (_, key) = self.order.pop_first()?;
+        self.stamp.remove(&key);
+        Some(key)
+    }
+}
+
