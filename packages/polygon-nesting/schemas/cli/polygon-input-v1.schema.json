{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfet07-polygon-labs/polygon-nesting/schemas/cli/polygon-input-v1.schema.json",
  "title": "Polygon nesting CLI polygon input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "polygons"],
  "properties": {
    "version": { "const": 1 },
    "polygons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/polygon" }
    }
  },
  "$defs": {
    "finiteNumber": { "type": "number" },
    "point": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/finiteNumber" },
            { "$ref": "#/$defs/finiteNumber" }
          ],
          "items": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "$ref": "#/$defs/finiteNumber" },
            "y": { "$ref": "#/$defs/finiteNumber" }
          }
        }
      ]
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1 },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/point" }
        },
        "allowRotation": { "type": "boolean", "default": true },
        "allowMirror": { "type": "boolean", "default": true }
      }
    }
  }
}
